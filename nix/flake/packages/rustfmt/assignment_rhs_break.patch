+/// Returns `rewrite`, the rewrite in `shape` on the line of the `=`, `=>` or `:` in front of it, if
+/// it succeeded without breaking inside an empty pair of delimiters. Otherwise `rewrite_in`
+/// rewrites it on that line again, with one, two, four and more columns beyond `shape` each time,
+/// until a rewrite succeeds that way, and at last without any limit. So where nothing fits, the
+/// line grows past `max_width` about as little as it can instead of breaking after its `=`, `=>` or
+/// `:`.
+pub(crate) fn rewrite_on_same_line(
+    shape: Shape,
+    rewrite: RewriteResult,
+    rewrite_in: impl Fn(Shape) -> RewriteResult,
+) -> RewriteResult {
+    if let Ok(ref result) = rewrite {
+        if !breaks_empty_delimiter(result) {
+            return rewrite;
+        }
+    }
+    let infinite_shape = shape.infinite_width();
+    let mut extra_width = 1;
+    while shape.width + extra_width < infinite_shape.width {
+        let wider_shape = Shape {
+            width: shape.width + extra_width,
+            ..shape
+        };
+        match rewrite_in(wider_shape) {
+            Ok(result) if !breaks_empty_delimiter(&result) => return Ok(result),
+            _ => extra_width *= 2,
+        }
+    }
+    rewrite_in(infinite_shape)
+}
+
+/// Returns true if a line of `rewrite` ends in an opening delimiter that the next line closes at
+/// its start, as `(` and `)` of a call without arguments do where a shape is too narrow for both.
+fn breaks_empty_delimiter(rewrite: &str) -> bool {
+    let lines = rewrite.lines().map(str::trim).collect::<Vec<_>>();
+    lines.windows(2).any(|pair| {
+        [('(', ')'), ('[', ']'), ('{', '}'), ('<', '>')]
+            .iter()
+            .any(|&(opening, closing)| pair[0].ends_with(opening) && pair[1].starts_with(closing))
+    })
+}
+
+/// Returns `shape` with `width` taken off its first line, or a shape without any room on that line
+/// where `shape` is narrower than `width`.
+pub(crate) fn shape_after(shape: Shape, width: usize) -> Shape {
+    shape.offset_left_opt(width).unwrap_or(Shape {
+        width: 0,
+        offset: shape.offset + width,
+        ..shape
+    })
+}
+
+/// Returns true if `assignment_rhs_break` is `TrailingDelimiter`, the rhs ends in a delimited
+/// expression or type and `orig_rhs`, the rhs formatted on the line of the lhs, opens that delimiter at
+/// the end of its first line, closes it on its last line and holds at least one line between
+/// them, so an empty `()` never breaks.
+fn keeps_trailing_delimiter(
+    context: &RewriteContext<'_>,
+    rhs_kind: &RhsAssignKind<'_>,
+    orig_rhs: &str,
+) -> bool {
+    if context.config.assignment_rhs_break() != AssignmentRhsBreak::TrailingDelimiter {
+        return false;
+    }
+    let delimited_rhs = match rhs_kind {
+        RhsAssignKind::Expr(kind, _) => ends_in_delimited_expr(kind),
+        RhsAssignKind::Ty(kind) => ends_in_delimited_ty(kind),
+        RhsAssignKind::Bounds => false,
+    };
+    if !delimited_rhs {
+        return false;
+    }
+    let (Some(first_line), Some(last_line)) = (orig_rhs.lines().next(), orig_rhs.lines().last())
+    else {
+        return false;
+    };
+    let last_line = last_line.trim();
+    count_newlines(orig_rhs) >= 2
+        && first_line.ends_with(['(', '[', '{', '<'])
+        && last_line.starts_with([')', ']', '}', '>'])
+        && last_line.chars().all(|c| matches!(c, ')' | ']' | '}' | '>' | '?'))
+}
+
+/// Returns true if the expression ends in the delimiter of a call, a tuple, a struct literal, an
+/// array or a macro call, also behind any number of `?`.
+fn ends_in_delimited_expr(kind: &ast::ExprKind) -> bool {
+    match kind {
+        ast::ExprKind::Try(ref inner) => ends_in_delimited_expr(&inner.kind),
+        ast::ExprKind::Call(..)
+        | ast::ExprKind::MethodCall(..)
+        | ast::ExprKind::Tup(..)
+        | ast::ExprKind::Struct(..)
+        | ast::ExprKind::Array(..)
+        | ast::ExprKind::MacCall(..) => true,
+        _ => false,
+    }
+}
+
+/// Returns true if the type can end in the delimiter of its generic arguments, a tuple, an array,
+/// a slice or the parameters of a function pointer, also behind any number of references and
+/// pointers.
+fn ends_in_delimited_ty(kind: &ast::TyKind) -> bool {
+    match kind {
+        ast::TyKind::Ref(_, ref mut_ty)
+        | ast::TyKind::PinnedRef(_, ref mut_ty)
+        | ast::TyKind::Ptr(ref mut_ty) => ends_in_delimited_ty(&mut_ty.ty.kind),
+        ast::TyKind::Path(..)
+        | ast::TyKind::Tup(..)
+        | ast::TyKind::Array(..)
+        | ast::TyKind::Slice(..)
+        | ast::TyKind::FnPtr(..)
+        | ast::TyKind::TraitObject(..)
+        | ast::TyKind::ImplTrait(..) => true,
+        _ => false,
+    }
+}
