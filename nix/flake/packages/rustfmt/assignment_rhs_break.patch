+/// Controls where rustfmt breaks the right-hand side of an assignment that does not fit on
+/// the line of its left-hand side.
+#[config_type]
+pub enum AssignmentRhsBreak {
+    /// Use the heuristics of rustfmt, which often move the right-hand side to the next line.
+    Heuristic,
+    /// Keep a right-hand side that ends in a delimited expression, such as a call, a tuple, a
+    /// struct literal, an array or a macro call, or in a delimited type, such as generic
+    /// arguments, a tuple or a slice, on the line of the left-hand side and break inside its
+    /// trailing delimiter.
+    TrailingDelimiter,
+    /// Start every right-hand side on the line of its `=`, `=>` or `:` and break it only inside
+    /// itself, and let the line grow past `max_width` where it cannot break at all.
+    SameLine,
+}
