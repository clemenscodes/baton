{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/vocabulary-noun-rule.sh",
            "statusMessage": "Noun rule of the vocabulary"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/moon-cache-rule.sh",
            "statusMessage": "Cache rule of moon"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-time-bound-rule.sh",
            "statusMessage": "Time bound of tests"
          }
        ]
      }
    ]
  }
}
